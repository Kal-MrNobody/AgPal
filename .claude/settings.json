{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Grep(./.env)",
      "Grep(**/.env)",
      "Grep(**/.env.*)",
      "Bash(cat:*.env*)",
      "Bash(head:*.env*)",
      "Bash(tail:*.env*)",
      "Bash(less:*.env*)",
      "Bash(more:*.env*)",
      "Bash(grep:*.env*)",
      "Bash(rg:*.env*)",
      "Bash(sed:*.env*)",
      "Bash(awk:*.env*)",
      "Bash(cut:*.env*)",
      "Bash(sort:*.env*)",
      "Bash(xxd:*.env*)",
      "Bash(od:*.env*)",
      "Bash(base64:*.env*)",
      "Bash(cp:*.env*)",
      "Bash(source:*.env*)",
      "Bash(dotenv:*)",
      "Bash(printenv:*)",
      "Bash(env)"
    ]
  }
}
