{
  "name": "@agpal/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/main.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "webhooks:pull": "node --env-file-if-exists=../../.env --import tsx scripts/pull-webhooks.ts",
    "seed": "node --env-file-if-exists=../../.env --import tsx scripts/seed.ts",
    "approvals": "node --env-file-if-exists=../../.env --import tsx scripts/approvals.ts",
    "reconcile": "node --env-file-if-exists=../../.env --import tsx scripts/reconcile.ts",
    "loop:manual": "node --env-file-if-exists=../../.env --import tsx scripts/loop-manual.ts",
    "agent:run": "node --env-file-if-exists=../../.env --import tsx scripts/agent-run.ts",
    "sim:week": "node --env-file-if-exists=../../.env --import tsx scripts/sim-week.ts",
    "founder:link": "node --env-file-if-exists=../../.env --import tsx scripts/founder-link.ts",
    "schedule:seed": "node --env-file-if-exists=../../.env --import tsx scripts/schedule-seed.ts",
    "demo:hold": "node --env-file-if-exists=../../.env --import tsx scripts/demo-hold.ts"
  },
  "dependencies": {
    "@agpal/shared": "workspace:*",
    "@agpal/db": "workspace:*",
    "@agpal/policy": "workspace:*",
    "@agpal/agents": "workspace:*",
    "pg-boss": "12.38.2",
    "@agpal/ledger": "workspace:*",
    "drizzle-orm": "0.45.4",
    "@agpal/schedule": "workspace:*",
    "zod": "4.6.7"
  }
}
