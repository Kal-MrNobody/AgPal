# Copy to .env and fill in. .env is git-ignored and Claude Code is denied read access to it.
# Every variable here is validated at startup by packages/shared/src/env.ts.

NODE_ENV=development
LOG_LEVEL=info

# Postgres (docker compose up -d postgres)
DATABASE_URL=postgres://agpal:agpal@localhost:5432/agpal

# PayPal — sandbox only until real money moves
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set after registering the webhook (Prompt 7)
PAYPAL_WEBHOOK_ID=

# OpenAI — powers AgPal's agents at runtime (Prompt 10)
OPENAI_API_KEY=

# apps/api
API_PORT=4000
